{
  "name": "wasl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-logical.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > lib/db/types.ts",
    "lint:rtl": "node scripts/check-logical.mjs",
    "seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed.ts",
    "demo:reset": "tsx --env-file=.env.local --conditions=react-server scripts/demo-reset.ts",
    "seed:demo": "tsx --env-file=.env.local --conditions=react-server scripts/seed-demo.ts",
    "og": "node scripts/dev/og.mjs",
    "evals": "promptfoo eval -c evals/promptfooconfig.yaml --no-cache && promptfoo eval -c evals/classify.yaml --no-cache && npm run evals:sources && npm run evals:assist",
    "test:ai": "node --env-file=.env.local scripts/dev/ai-card.mjs",
    "evals:classify": "promptfoo eval -c evals/classify.yaml --no-cache",
    "library:seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed-library.ts",
    "evals:assist": "tsx --env-file=.env.local --conditions=react-server evals/assist-rules.ts",
    "evals:sources": "tsx --conditions=react-server evals/sources-rules.ts && promptfoo eval -c evals/sources.yaml --no-cache"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "promptfoo": "^0.123.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@swc/core": "1.16.2"
  }
}
